+static void airoha_an7563_stall_monitor_start(struct airoha_eth *eth)
+{
+	if (eth->soc->version != 0x7563)
+		return;
+
+	INIT_DELAYED_WORK(&eth->stall_work, airoha_an7563_stall_work);
+	eth->irq_events_seen = eth->irq_events;
+	schedule_delayed_work(&eth->stall_work, HZ);
+	airoha_an7563_stall_debugfs_init(eth);
+}
+
+static void airoha_an7563_stall_monitor_stop(struct airoha_eth *eth)
+{
+	if (eth->soc->version != 0x7563)
+		return;
+
+	cancel_delayed_work_sync(&eth->stall_work);
+	debugfs_lookup_and_remove("airoha_fe_stall", NULL);
+}
+
 static void airoha_update_hw_stats(struct airoha_gdm_dev *dev)

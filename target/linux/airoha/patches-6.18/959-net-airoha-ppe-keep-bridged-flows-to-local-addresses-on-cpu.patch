From: Pavel Bragin <pabragin@yandex.ru>
Subject: [PATCH] net: airoha: ppe: do not bind bridged flows to local addresses

A LAN client whose route to the router goes through another router on
the same LAN sends packets that cross the bridge twice with the same
tuple: client -> other router, then other router -> this router. The
PPE hash has no ingress port, so the L2 subflow bound on the first pass
also matched the second one and sent it back to the other router: the
packets looped and never reached the CPU (an AmneziaWG tunnel to the
router hung with the NPU on). Leave such flows to the CPU.

Signed-off-by: Pavel Bragin <pabragin@yandex.ru>
---
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -9,6 +9,7 @@
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/rhashtable.h>
+#include <net/addrconf.h>
 #include <net/ipv6.h>
 #include <net/pkt_cls.h>
 #include <net/route.h>
@@ -913,6 +914,36 @@
 	return 0;
 }
 
+/* A bridged packet for one of our own addresses can cross the bridge twice
+ * with the same tuple, e.g. a LAN client whose route to this router goes
+ * through another router on the same LAN. The hash has no ingress port, so
+ * a subflow bound on the first pass would catch the second one as well and
+ * send it back to the other router instead of to the CPU.
+ */
+static bool airoha_ppe_foe_dest_is_local(struct sk_buff *skb,
+					 struct airoha_foe_entry *hwe)
+{
+	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+	struct net *net = skb->dev ? dev_net(skb->dev) : &init_net;
+
+	switch (type) {
+	case PPE_PKT_TYPE_IPV4_HNAPT:
+	case PPE_PKT_TYPE_IPV4_ROUTE:
+		return inet_addr_type(net,
+				      cpu_to_be32(hwe->ipv4.orig_tuple.dest_ip)) ==
+		       RTN_LOCAL;
+	case PPE_PKT_TYPE_IPV6_ROUTE_3T:
+	case PPE_PKT_TYPE_IPV6_ROUTE_5T: {
+		struct in6_addr addr;
+
+		ipv6_addr_cpu_to_be32(addr.s6_addr32, hwe->ipv6.dest_ip);
+		return ipv6_chk_addr(net, &addr, NULL, 0);
+	}
+	default:
+		return false;
+	}
+}
+
 static void airoha_ppe_foe_insert_entry(struct airoha_ppe *ppe,
 					struct sk_buff *skb,
 					u32 hash, bool rx_wlan)
@@ -959,7 +990,7 @@
 	airoha_ppe_foe_set_bridge_addrs(&br, eth_hdr(skb));
 	e = rhashtable_lookup_fast(&ppe->l2_flows, &br,
 				   airoha_l2_flow_table_params);
-	if (e)
+	if (e && !airoha_ppe_foe_dest_is_local(skb, hwe))
 		airoha_ppe_foe_commit_subflow_entry(ppe, e, hash, rx_wlan);
 unlock:
 	spin_unlock_bh(&ppe_lock);

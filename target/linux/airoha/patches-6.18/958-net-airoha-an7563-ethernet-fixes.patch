@@ -1283,19 +1396,52 @@
 			goto unlock;
 
 		desc = &q->desc[index];
-		desc_ctrl = le32_to_cpu(desc->ctrl);
+		e = &q->entry[index];
+
+		/* A report for an entry that is not in flight (already
+		 * released, or never queued) must not release it again: a
+		 * second list_add_tail() corrupts q->tx_list, q->queued drops
+		 * below the real count and the same entry later goes to two
+		 * frames, losing one skb and its BQL completion.
+		 */
+		if (e->dma_type == AIROHA_DMA_UNMAPPED) {
+			eth->tx_report_stale++;
+			goto unlock;
+		}
+
+		/* On AN7563 the report can arrive before the descriptor write
+		 * back: give DONE a few microseconds instead of dropping the
+		 * report, which would leave the entry in flight for good.
+		 */
+		desc_ctrl = le32_to_cpu(READ_ONCE(desc->ctrl));
+		if (!(desc_ctrl & (QDMA_DESC_DONE_MASK | QDMA_DESC_DROP_MASK)) &&
+		    eth->soc->version == 0x7563) {
+			int try;
+
+			for (try = 0; try < 20; try++) {
+				udelay(1);
+				dma_rmb();
+				desc_ctrl = le32_to_cpu(READ_ONCE(desc->ctrl));
+				if (desc_ctrl & (QDMA_DESC_DONE_MASK |
+						 QDMA_DESC_DROP_MASK))
+					break;
+			}
+		}
 
 		if (!(desc_ctrl & QDMA_DESC_DONE_MASK) &&
-		    !(desc_ctrl & QDMA_DESC_DROP_MASK))
+		    !(desc_ctrl & QDMA_DESC_DROP_MASK)) {
+			eth->tx_report_late++;
 			goto unlock;
+		}
 
-		e = &q->entry[index];
 		skb = e->skb;
 		e->skb = NULL;
 
 		airoha_unmap_xmit_buf(eth, e);
 		list_add_tail(&e->list, &q->tx_list);
 
+		/* no stale DONE for a later report of this slot */
+		WRITE_ONCE(desc->ctrl, 0);
 		WRITE_ONCE(desc->msg0, 0);
 		WRITE_ONCE(desc->msg1, 0);
 		q->queued--;

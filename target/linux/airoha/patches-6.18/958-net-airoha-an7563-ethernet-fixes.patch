+/* The AN7563 PSE comes up with 1024 64-byte pages and shared-pool
+ * thresholds above the shared pool itself, so under CPU-forwarded load the
+ * page pool runs dry and the frame engine deadlocks. The stock driver
+ * (fe_core.ko init_module: pse_page_set_to_128Byte, pse_set_total_page,
+ * setup_pse_IQ_reservation, pse_set_share_threshold) gives the PSE
+ * 128-byte pages, the GDMP SRAM as 256 extra pages (1280 in all), the
+ * input-queue reserves and fixed shared-pool thresholds. Do the same.
+ */
+#define AN7563_GDMP_BASE			0x1fbf9000
+#define AN7563_GDMP_SIZE			0x84
+#define AN7563_GDMP_DATA_SEL			0x74
+#define AN7563_GDMP_DATA_SEL_MASK		GENMASK(1, 0)
+#define AN7563_GDMP_DATA_SEL_FE			3
+#define AN7563_SCU_SSR3				0x94
+#define AN7563_SCU_SSR3_PCIE_HSGMII1_SEL	BIT(30)
+#define AN7563_PSE_FQ_PAGES			0x500
+#define AN7563_PSE_SHARE_USED_HTHD		500
+#define AN7563_PSE_SHARE_USED_MTHD		480
+
+static int airoha_fe_an7563_pse_init(struct airoha_eth *eth)
+{
+	void __iomem *gdmp;
+	struct regmap *scu;
+	u32 val;
+
+	/* PSE page 128 B, as airoha_fe_init() sets for the other SoCs */
+	airoha_fe_rmw(eth, REG_FE_DMA_GLO_CFG,
+		      FE_DMA_GLO_L2_SPACE_MASK | FE_DMA_GLO_PG_SZ_MASK,
+		      FIELD_PREP(FE_DMA_GLO_L2_SPACE_MASK, 2) |
+		      FE_DMA_GLO_PG_SZ_MASK);
+
+	/* hand the GDMP SRAM to the frame engine (stock gdump_mode_sel(3)) */
+	gdmp = ioremap(AN7563_GDMP_BASE, AN7563_GDMP_SIZE);
+	if (!gdmp) {
+		dev_err(eth->dev, "cannot map the GDMP block\n");
+		return -ENOMEM;
+	}
+	val = readl(gdmp + AN7563_GDMP_DATA_SEL);
+	val &= ~AN7563_GDMP_DATA_SEL_MASK;
+	val |= FIELD_PREP(AN7563_GDMP_DATA_SEL_MASK, AN7563_GDMP_DATA_SEL_FE);
+	writel(val, gdmp + AN7563_GDMP_DATA_SEL);
+	iounmap(gdmp);
+
+	/* the stock driver changes this clock select along with it */
+	scu = syscon_regmap_lookup_by_compatible("airoha,an7563-scu");
+	if (IS_ERR(scu)) {
+		dev_err(eth->dev, "cannot get the SCU: %ld\n", PTR_ERR(scu));
+		return PTR_ERR(scu);
+	}
+	regmap_clear_bits(scu, AN7563_SCU_SSR3,
+			  AN7563_SCU_SSR3_PCIE_HSGMII1_SEL);
+
+	airoha_fe_rmw(eth, PSE_FQ_CFG, PSE_FQ_LIMIT_MASK,
+		      FIELD_PREP(PSE_FQ_LIMIT_MASK, AN7563_PSE_FQ_PAGES));
+
+	/* PSE IQ reserve, the same values as for the other SoCs */
+	airoha_fe_rmw(eth, REG_PSE_IQ_REV1, PSE_IQ_RES1_P2_MASK,
+		      FIELD_PREP(PSE_IQ_RES1_P2_MASK, 0x10));
+	airoha_fe_rmw(eth, REG_PSE_IQ_REV2,
+		      PSE_IQ_RES2_P5_MASK | PSE_IQ_RES2_P4_MASK,
+		      FIELD_PREP(PSE_IQ_RES2_P5_MASK, 0x40) |
+		      FIELD_PREP(PSE_IQ_RES2_P4_MASK, 0x34));
+
+	/* shared-pool thresholds, the stock constants */
+	airoha_fe_wr(eth, REG_PSE_SHARE_USED_THD,
+		     FIELD_PREP(PSE_SHARE_USED_MTHD_MASK,
+				AN7563_PSE_SHARE_USED_MTHD) |
+		     FIELD_PREP(PSE_SHARE_USED_HTHD_MASK,
+				AN7563_PSE_SHARE_USED_HTHD));
+
+	/* the rest of the stock fe_core init: CPU port flow control per
+	 * port instead of per queue, MBI aging on GDM1/GDM2 (the vendor's
+	 * workaround for a stuck GDM channel), PSE error events latched in
+	 * REG_FE_INT_STATUS (polled by the stall monitor, no interrupt)
+	 */
+	airoha_fe_clear(eth, REG_FE_CPORT_CFG, FE_CPORT_QUEUE_XFC_MASK);
+	airoha_fe_set(eth, REG_FE_CPORT_CFG, FE_CPORT_PORT_XFC_MASK);
+	airoha_fe_rmw(eth, REG_GDM_CHN_RLS(1),
+		      MBI_RX_AGE_SEL_MASK | MBI_TX_AGE_SEL_MASK,
+		      FIELD_PREP(MBI_RX_AGE_SEL_MASK, 3) |
+		      FIELD_PREP(MBI_TX_AGE_SEL_MASK, 3));
+	airoha_fe_rmw(eth, REG_GDM_CHN_RLS(2),
+		      MBI_RX_AGE_SEL_MASK | MBI_TX_AGE_SEL_MASK,
+		      FIELD_PREP(MBI_RX_AGE_SEL_MASK, 3) |
+		      FIELD_PREP(MBI_TX_AGE_SEL_MASK, 3));
+	airoha_fe_wr(eth, REG_FE_INT_STATUS, 0xffffffff);
+
+	/* a frame engine core reset makes the page setup effective */
+	airoha_fe_wr(eth, REG_FE_RST_GLO_CFG, FE_RST_CORE_MASK);
+	usleep_range(1000, 2000);
+
+	dev_info(eth->dev,
+		 "PSE: %u pages, glo %08x, rsv %08x, thresholds %08x\n",
+		 (u32)airoha_fe_get(eth, PSE_FQ_CFG, PSE_FQ_LIMIT_MASK),
+		 airoha_fe_rr(eth, REG_FE_DMA_GLO_CFG),
+		 airoha_fe_rr(eth, REG_FE_PSE_BUF_SET),
+		 airoha_fe_rr(eth, REG_PSE_SHARE_USED_THD));
+
+	return 0;
+}

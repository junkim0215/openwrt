# JFFS2 on the SPI-NAND of the Xiaomi BE5000 corrupts pages it programs
# twice (cleanmarker in OOB, then data), so the overlay lives in the
# rootfs_data volume of the UBI in the "ubi-data" partition. Attach it
# (be5000-ubi.sh) and create the volume, with its /dev node, before
# mount_root looks for it. An initramfs may run on a factory layout: leave
# the flash alone there.

. /lib/upgrade/nand.sh
. /lib/upgrade/be5000-ubi.sh

ubi_rootfs_data() {
	local ubidev

	[ "$INITRAMFS" = "1" ] && return 0
	case "$(board_name)" in
	xiaomi,be5000) ;;
	*) return 0 ;;
	esac

	ubidev="$(be5000_ubi_attach)"
	if [ -z "$ubidev" ]; then
		# mount_root then falls back to the JFFS2 rootfs_data that
		# mtdsplit leaves behind the squashfs in "firmware"
		be5000_ubi_log "ERROR: no UBI, the overlay falls back to JFFS2"
		return 0
	fi

	[ -n "$(nand_find_volume "$ubidev" rootfs_data)" ] && return 0

	be5000_ubi_log "creating the rootfs_data volume"
	echo "- creating rootfs_data UBI volume -"
	if ! ubimkvol "/dev/$ubidev" -N rootfs_data -m >/dev/null; then
		be5000_ubi_log "ERROR: ubimkvol failed, the overlay falls back to JFFS2"
		return 0
	fi
	# mount_root opens the volume by its /dev node, which does not exist
	# yet in preinit: nand_find_volume() creates it.
	nand_find_volume "$ubidev" rootfs_data >/dev/null
}

boot_hook_add preinit_main ubi_rootfs_data

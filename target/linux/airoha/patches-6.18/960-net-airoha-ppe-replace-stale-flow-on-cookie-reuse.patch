From: Pavel Bragin <pavel@chartmogul.com>
Subject: net: airoha: ppe: replace a stale flow entry on cookie reuse

nf_flowtable passes the address of the flow tuple as cookie. When the
flowtable is rebuilt (fw4 reload, switching the offload mode) the old
flows do not always get FLOW_CLS_DESTROY in the driver and their
entries stay in eth->flow_table. A new flow allocated at the same
address then gets -EEXIST from every callback and is never offloaded: its PPE entry
stays unbound, every packet goes through the CPU and one such TCP flow
drags the whole Wi-Fi upload down to ~250-300 Mbit/s.

Only return -EEXIST when the entry under the cookie describes the same
flow (another block callback offering it again) and replace a stale one.

--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -1148,10 +1148,6 @@
 	int err, i, offload_type;
 	u16 addr_type = 0;
 
-	if (rhashtable_lookup(&eth->flow_table, &f->cookie,
-			      airoha_flow_table_params))
-		return -EEXIST;
-
 	if (!flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_META))
 		return -EOPNOTSUPP;
 
@@ -1316,6 +1312,25 @@
 			return err;
 	}
 
+	/* The flowtable uses the address of the flow as cookie. Flows of a
+	 * rebuilt flowtable (firewall reload) do not always get
+	 * FLOW_CLS_DESTROY here, so their entries stay in the table and a
+	 * new flow allocated at the same address would never be offloaded.
+	 * Keep -EEXIST only for the same flow offered by another block
+	 * callback and replace a stale entry.
+	 */
+	e = rhashtable_lookup(&eth->flow_table, &f->cookie,
+			      airoha_flow_table_params);
+	if (e) {
+		if (!memcmp(&e->data.d, &hwe.d, sizeof(hwe) - sizeof(hwe.ib1)))
+			return -EEXIST;
+
+		airoha_ppe_foe_flow_remove_entry(eth->ppe, e);
+		rhashtable_remove_fast(&eth->flow_table, &e->node,
+				       airoha_flow_table_params);
+		kfree(e);
+	}
+
 	e = kzalloc(sizeof(*e), GFP_KERNEL);
 	if (!e)
 		return -ENOMEM;

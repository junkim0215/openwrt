# downloads.openwrt.org has no airoha/an7563 target and none of the awg,
# nikki, podkop, youtubeUnblock, zapret, passwall, passwall2,
# passwall_packages and openclash feeds that feeds.conf.default adds. Drop
# them, otherwise "apk update" fails on the missing indexes.

. /lib/functions.sh

case "$(board_name)" in iptime,be5100m|iptime,be3600p) ;; *) exit 0 ;; esac

feeds=/etc/apk/repositories.d/distfeeds.list

sed -i "\,/targets/airoha/an7563/,d" "$feeds"
sed -i "\,/packages/[^/]*/\(awg\|zapret\|nikki\|podkop\|youtubeUnblock\|passwall\|passwall2\|passwall_packages\|openclash\)/packages.adb\$,d" "$feeds"

exit 0

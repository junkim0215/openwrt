[ -e /etc/config/ubootenv ] && exit 0

touch /etc/config/ubootenv

. /lib/uboot-envtools.sh
. /lib/functions.sh

board=$(board_name)

case "$board" in
xiaomi,be5000)
	ubootenv_add_mtd "u-boot-env" "0x1c000" "0x4000" "0x20000"
	;;
iptime,be5100m)
	ubootenv_add_mtd "u-boot-env" "0x0" "0x4000" "0x20000"
	;;
esac

config_load ubootenv
config_foreach ubootenv_add_app_config

exit 0

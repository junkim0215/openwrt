. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

an7563_setup_interfaces()
{
	local board="$1"

	case "$board" in
	airoha,an7563-evb)
		ucidef_set_interface_lan "eth0"
		;;
	xiaomi,be5000)
		# 2.5G port is WAN like on stock. The kernel takes the port MACs from
		# the stock U-Boot environment ("stock-env", the first block of "art")
		# through NVMEM; the same pair is kept in the config for br-lan and
		# wan, with a random fallback when the environment is gone
		local lan_mac=$(mtd_get_mac_ascii stock-env ethaddr)
		local wan_mac=$(mtd_get_mac_ascii stock-env ethaddr_wan)
		[ -n "$lan_mac" ] || lan_mac=$(macaddr_random)
		[ -n "$wan_mac" ] || wan_mac=$(macaddr_add "$lan_mac" 1)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3" "eth1"
		ucidef_set_interface_macaddr "lan" "$lan_mac"
		ucidef_set_interface_macaddr "wan" "$wan_mac"
		ucidef_set_label_macaddr "$wan_mac"
		;;
	*)
		echo "Unsupported hardware. Network interfaces not initialized"
		;;
	esac
}

board_config_update
board=$(board_name)
an7563_setup_interfaces $board
board_config_flush

exit 0

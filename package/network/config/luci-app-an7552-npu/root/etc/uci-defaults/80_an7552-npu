#!/bin/sh

[ -s /etc/config/an7552-npu ] || cat > /etc/config/an7552-npu <<'X'
config npu 'settings'
	option enabled '1'
X

uci -q get an7552-npu.wifi >/dev/null || {
	uci set an7552-npu.wifi=wifi
	uci set an7552-npu.wifi.gaming=0
	uci commit an7552-npu
}

uci -q get an7552-npu.pppoe >/dev/null || {
	uci set an7552-npu.pppoe=pppoe
	uci set an7552-npu.pppoe.mss=1452
	uci commit an7552-npu
}
exit 0

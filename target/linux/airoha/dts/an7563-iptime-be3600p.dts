/dts-v1/;

/* Bootloader installs ATF here (BL31 resident region, ~256 KiB). */
/memreserve/ 0x80000000 0x88000;

#include <dt-bindings/gpio/gpio.h>
#include "an7563.dtsi"

/*
 * ipTIME BE3600plus, first bring-up for RAM boot only: 256 MiB RAM,
 * MT7990 (14c3:7993 + 14c3:799b) on pcie0/pcie1 with its calibration in
 * "art". Wi-Fi, LEDs, buttons and USB are left out until the hardware is
 * checked, and every partition is read-only.
 */

/ {
	model = "ipTIME BE3600plus";
	compatible = "iptime,be3600p", "airoha,an7563", "airoha,en7581";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x10000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		npu_firmware: npu-firmware@84000000 {
			reg = <0x84000000 0x300000>;
			no-map;
		};

		npu_pkt: npu-pkt@84400000 {
			reg = <0x84400000 0x1600000>;
			no-map;
		};
	};
};

&an7563_pinctrl {
	gpio-ranges = <&an7563_pinctrl 0 0 28>;

	wifi-enable-hog {
		/* Stock U-Boot drives GPIO 6 high; stock resets the Wi-Fi with it. */
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "wifi-enable";
	};
};

&npu {
	memory-region = <&npu_firmware>, <&npu_pkt>;
	memory-region-names = "firmware", "pkt";
	status = "okay";
};

&pcie0 {
	ranges = <0x82000000 0 0x20000000 0x20000000 0 0x4000000>;
	status = "okay";
};

&pcie1 {
	ranges = <0x82000000 0 0x24000000 0x24000000 0 0x4000000>;
	status = "okay";
};

&snfi {
	status = "okay";
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";
};

&i2c0 {
	status = "okay";
};

/* Same stock layout and DT order as the BE5100M (mtd numbers match stock). */
&spi_nand {
	airoha,bmt;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bootloader";
			reg = <0x0 0x80000>;
			read-only;
		};

		partition@80000 {
			label = "u-boot-env";
			reg = <0x80000 0x80000>;
			read-only;
		};

		partition@100000 {
			label = "Factory";
			reg = <0x100000 0x400000>;
			read-only;
		};

		partition@500000 {
			label = "tclinux";
			reg = <0x500000 0x2800000>;
			read-only;
		};

		partition@5500000 {
			label = "stock_data";
			reg = <0x5500000 0x800000>;
			read-only;
		};

		partition@6c80000 {
			label = "art";
			reg = <0x6c80000 0x380000>;
			read-only;
		};

		partition@2d00000 {
			label = "tclinux_slave";
			reg = <0x2d00000 0x2800000>;
			read-only;
		};
	};
};

&hsgmii_pcs {
	status = "okay";
};

/* Probe for an EN8811H like on the BE5100M; stock loads its driver too. */
&gsw_mdio {
	phy_2p5g: ethernet-phy@f {
		compatible = "ethernet-phy-id03a2.a411";
		reg = <15>;
		reset-gpios = <&an7563_pinctrl 13 GPIO_ACTIVE_LOW>;
		reset-assert-us = <1000000>;
		reset-deassert-us = <100000>;
	};
};

&gdm2 {
	phy-handle = <&phy_2p5g>;
	status = "okay";
};

&switch {
	status = "okay";
};

&gsw_port1 {
	label = "lan1";
	status = "okay";
};

&gsw_port2 {
	label = "lan2";
	status = "okay";
};

&gsw_port3 {
	label = "lan3";
	status = "okay";
};

&gsw_port4 {
	label = "lan4";
	status = "okay";
};

#!/bin/sh /etc/rc.common
# Load mt7996e with or without the AN7552 NPU offload as configured, set
# the 5 GHz BE TXOP for the gaming mode, the TCP MSS on PPPoE links and the
# Wi-Fi 7 MLO network.
# At boot this runs before netifd brings Wi-Fi up and before firewall4.

START=19
USE_PROCD=1

PARAM=/sys/module/mt7996e/parameters/npu_enable
MSS_NFT=/etc/nftables.d/90-pppoe-mss.nft
MLO_IFACE=an7552_mlo

# Gaming mode: 2 ms BE TXOP on 5 GHz radios. Off: back to the 16 ms the
# image sets, unless the TXOP was changed by hand.
txop_apply() {
	local gaming want radio opt cur changed=

	config_load an7552-npu
	config_get_bool gaming wifi gaming 0

	for radio in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
		[ "$(uci -q get wireless.$radio.band)" = 5g ] || continue
		cur=
		for opt in $(uci -q get wireless.$radio.hostapd_options); do
			case "$opt" in tx_queue_data2_burst=*) cur=${opt#*=};; esac
		done
		if [ "$gaming" = 1 ]; then
			want=2.0
		elif [ "$cur" = 2.0 ]; then
			want=16.0
		else
			continue
		fi
		[ "$cur" = "$want" ] && continue
		[ -n "$cur" ] && uci del_list wireless.$radio.hostapd_options=tx_queue_data2_burst=$cur
		uci add_list wireless.$radio.hostapd_options=tx_queue_data2_burst=$want
		changed=1
	done
	[ -n "$changed" ] || return 1
	uci commit wireless
	logger -t an7552-npu "5 GHz BE TXOP set for gaming mode $gaming"
	return 0
}

npu_apply() {
	local enabled want running

	config_load an7552-npu
	config_get_bool enabled settings enabled 1
	[ "$enabled" = 1 ] && want=Y || want=N

	# Nothing to do without the driver, or when it already matches.
	[ -r "$PARAM" ] || return 1
	[ "$(cat "$PARAM")" = "$want" ] && return 1

	ubus -t 2 list network.wireless >/dev/null 2>&1 && running=1
	[ -n "$running" ] && wifi down
	sleep 1
	rmmod mt7996e && insmod mt7996e npu_enable=$want
	logger -t an7552-npu "mt7996e reloaded with npu_enable=$want"
	[ -n "$running" ] && wifi up
	return 0
}

# PPPoE MSS: the PPE cannot send a packet larger than the PPPoE MTU and
# leaves it to the CPU. fw4 clamps the MSS from the routes, which misses
# connections routed by policy (pbr, mwan3), so set a fixed value on every
# pppoe-* interface, IPv6 20 bytes lower. Returns 0 when the file changed.
mss_apply() {
	local mss mss6 rules=

	config_load an7552-npu
	config_get mss pppoe mss
	case "$mss" in
	''|*[!0-9]*) ;;
	*)
		if [ "$mss" -ge 536 ] && [ "$mss" -le 1460 ]; then
			mss6=$((mss - 20))
			rules="# Generated by /etc/init.d/an7552-npu from an7552-npu.pppoe.mss
chain pppoe_mss {
	type filter hook forward priority mangle + 1; policy accept;
	meta nfproto ipv4 iifname \"pppoe-*\" tcp flags syn / syn,fin,rst tcp option maxseg size > $mss tcp option maxseg size set $mss
	meta nfproto ipv4 oifname \"pppoe-*\" tcp flags syn / syn,fin,rst tcp option maxseg size > $mss tcp option maxseg size set $mss
	meta nfproto ipv6 iifname \"pppoe-*\" tcp flags syn / syn,fin,rst tcp option maxseg size > $mss6 tcp option maxseg size set $mss6
	meta nfproto ipv6 oifname \"pppoe-*\" tcp flags syn / syn,fin,rst tcp option maxseg size > $mss6 tcp option maxseg size set $mss6
}"
		fi
		;;
	esac

	if [ -n "$rules" ]; then
		[ "$(cat "$MSS_NFT" 2>/dev/null)" = "$rules" ] && return 1
		mkdir -p "${MSS_NFT%/*}"
		printf '%s\n' "$rules" > "$MSS_NFT"
	else
		[ -e "$MSS_NFT" ] || return 1
		rm -f "$MSS_NFT"
	fi
	logger -t an7552-npu "PPPoE MSS set to ${mss:-off}"
	return 0
}

# Radio settings while MLO is on: 40 MHz on 2.4 GHz even next to other
# networks (noscan), 160 MHz on 5 GHz where the channel allows it. The
# previous value of each option is kept in an7552-npu.mlo as
# saved_<band>_<option> ("-" = unset) and comes back when MLO is off.
mlo_radio_set() { # <radio> <band> <option> <value>
	local saved

	config_get saved mlo saved_$2_$3
	if [ -z "$saved" ]; then
		saved=$(uci -q get wireless.$1.$3)
		uci set an7552-npu.mlo.saved_$2_$3="${saved:--}"
	fi
	uci set wireless.$1.$3="$4"
}

mlo_radio_restore() { # <radio> <band> <option>
	local saved

	config_get saved mlo saved_$2_$3
	[ -n "$saved" ] || return 0
	if [ "$saved" = - ]; then
		uci -q delete wireless.$1.$3
	else
		uci set wireless.$1.$3="$saved"
	fi
	uci -q delete an7552-npu.mlo.saved_$2_$3
}

# Wi-Fi 7 MLO: one WPA3 wifi-iface over every enabled 2.4 and 5 GHz radio.
# The section is owned by this script: it is rebuilt from an7552-npu.mlo
# and removed when MLO is off. Returns 0 when the wireless config changed.
mlo_apply() {
	local enabled ssid key network radio radios= radio2= radio5= n=0 on= cur new

	config_load an7552-npu
	config_get_bool enabled mlo enabled 0
	config_get ssid mlo ssid
	config_get key mlo key
	config_get network mlo network lan

	for radio in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
		case "$(uci -q get wireless.$radio.band)" in
		2g) radio2=$radio;;
		5g) radio5=$radio;;
		*) continue;;
		esac
		[ "$(uci -q get wireless.$radio.disabled)" = 1 ] && continue
		radios="$radios $radio"
		n=$((n + 1))
	done

	cur=$(uci -q show wireless.$MLO_IFACE; for radio in $radio2 $radio5; do uci -q show wireless.$radio; done)
	uci -q delete wireless.$MLO_IFACE
	if [ "$enabled" = 1 ] && [ -n "$ssid" ] && [ ${#key} -ge 8 ] && [ $n -ge 2 ]; then
		on=1
		uci set wireless.$MLO_IFACE=wifi-iface
		for radio in $radios; do
			uci add_list wireless.$MLO_IFACE.device=$radio
		done
		uci set wireless.$MLO_IFACE.mlo=1
		uci set wireless.$MLO_IFACE.mode=ap
		uci set wireless.$MLO_IFACE.network="$network"
		uci set wireless.$MLO_IFACE.ssid="$ssid"
		uci set wireless.$MLO_IFACE.encryption=sae
		uci set wireless.$MLO_IFACE.key="$key"
	elif [ "$enabled" = 1 ]; then
		logger -t an7552-npu "MLO needs a name, a password of 8+ characters and two radios"
	fi

	if [ -n "$on" ]; then
		if [ -n "$radio2" ]; then
			mlo_radio_set $radio2 2g htmode EHT40
			mlo_radio_set $radio2 2g noscan 1
		fi
		# 160 MHz only fits channels 36-64 (or auto) in most regions
		case "$(uci -q get wireless.$radio5.channel)" in
		''|auto|36|40|44|48|52|56|60|64)
			[ -n "$radio5" ] && mlo_radio_set $radio5 5g htmode EHT160;;
		*)
			logger -t an7552-npu "5 GHz channel $(uci -q get wireless.$radio5.channel) has no 160 MHz, width left as is";;
		esac
	else
		[ -n "$radio2" ] && mlo_radio_restore $radio2 2g htmode
		[ -n "$radio2" ] && mlo_radio_restore $radio2 2g noscan
		[ -n "$radio5" ] && mlo_radio_restore $radio5 5g htmode
	fi
	uci commit an7552-npu

	new=$(uci -q show wireless.$MLO_IFACE; for radio in $radio2 $radio5; do uci -q show wireless.$radio; done)
	if [ "$cur" = "$new" ]; then
		uci revert wireless
		return 1
	fi
	uci commit wireless
	if [ -n "$on" ]; then
		logger -t an7552-npu "MLO network $ssid set on$radios"
	else
		logger -t an7552-npu "MLO network removed"
	fi
	return 0
}

start_service() {
	mss_apply
	txop_apply
	mlo_apply
	npu_apply
}

reload_service() {
	local wifi_changed= mlo_changed=

	mss_apply && /etc/init.d/firewall reload
	txop_apply && wifi_changed=1
	mlo_apply && mlo_changed=1
	# a driver reload restarts Wi-Fi with the new settings anyway
	npu_apply && return 0
	ubus -t 2 list network.wireless >/dev/null 2>&1 || return 0
	# hostapd cannot replace a changed MLD BSS in place: the 2.4 GHz link
	# fails with "Link ID 0 already in use" and takes that radio down
	if [ -n "$mlo_changed" ]; then
		wifi down
		wifi up
	elif [ -n "$wifi_changed" ]; then
		wifi reload
	fi
	return 0
}

service_triggers() {
	procd_add_reload_trigger an7552-npu
}

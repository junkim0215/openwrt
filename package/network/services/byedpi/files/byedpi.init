#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	local enabled options

	config_load byedpi
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get options main options '-i 127.0.0.1 -p 1080'

	procd_open_instance
	procd_set_param command /usr/bin/ciadpi $options
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger byedpi
}

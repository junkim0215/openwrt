/dts-v1/;

/* Bootloader installs ATF here (BL31 resident region, ~256 KiB). */
/memreserve/ 0x80000000 0x88000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "an7563.dtsi"

/*
 * ipTIME BE3600plus: 256 MiB RAM, MT7990 (14c3:7993 + 14c3:799b) with its
 * EEPROM at Factory 0x0, WAN on switch port 4, no EN8811H. The port MACs
 * are below the Wi-Fi MAC at Factory 0x4, as on stock: LAN -2, WAN -1.
 * OpenWrt lives in tclinux_slave; everything else stays read-only.
 */

/ {
	model = "ipTIME BE3600plus";
	compatible = "iptime,be3600p", "airoha,an7563", "airoha,en7581";

	aliases {
		serial0 = &uart1;
		led-boot = &led_status;
		led-failsafe = &led_status;
		led-running = &led_status;
		led-upgrade = &led_status;
	};

	chosen {
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x10000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		npu_firmware: npu-firmware@84000000 {
			reg = <0x84000000 0x300000>;
			no-map;
		};

		npu_pkt: npu-pkt@84400000 {
			reg = <0x84400000 0x1600000>;
			no-map;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&an7563_pinctrl 25 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&an7563_pinctrl 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_status: led-status {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&an7563_pinctrl 21 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led-wlan-2g {
			function = LED_FUNCTION_WLAN_2GHZ;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&an7563_pinctrl 1 GPIO_ACTIVE_LOW>;
		};

		led-wlan-5g {
			function = LED_FUNCTION_WLAN_5GHZ;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&an7563_pinctrl 12 GPIO_ACTIVE_LOW>;
		};
	};
};

&an7563_pinctrl {
	gpio-ranges = <&an7563_pinctrl 0 0 28>;

	wifi-enable-hog {
		/* Stock U-Boot drives GPIO 6 high; stock resets the Wi-Fi with it. */
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "wifi-enable";
	};
};

&npu {
	memory-region = <&npu_firmware>, <&npu_pkt>;
	memory-region-names = "firmware", "pkt";
	status = "okay";
};

&pcie0 {
	ranges = <0x82000000 0 0x20000000 0x20000000 0 0x4000000>;
	status = "okay";

	pcie@0,0 {
		device_type = "pci";
		reg = <0x0000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi@0,0 {
			/*
			 * No airoha,npu/airoha,eth: the source-built AN7552 NPU
			 * firmware handles the MT7992 only, and on this MT7990 the
			 * fallback mt76_npu_init() calls a NULL op. Wi-Fi uses the CPU.
			 */
			compatible = "pci14c3,7993";
			reg = <0x0000 0 0 0 0>;
			nvmem-cells = <&wifi_eeprom>;
			nvmem-cell-names = "eeprom";
		};
	};
};

&pcie1 {
	ranges = <0x82000000 0 0x24000000 0x24000000 0 0x4000000>;
	status = "okay";
};

&snfi {
	status = "okay";
};

&eth {
	status = "okay";
};

&gdm1 {
	nvmem-cells = <&macaddr_factory_4 (-2)>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};

&i2c0 {
	status = "okay";
};

/* Same stock layout and DT order as the BE5100M (mtd numbers match stock). */
&spi_nand {
	airoha,bmt;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bootloader";
			reg = <0x0 0x80000>;
			read-only;
		};

		partition@80000 {
			label = "u-boot-env";
			reg = <0x80000 0x80000>;
		};

		partition@100000 {
			label = "Factory";
			reg = <0x100000 0x400000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				wifi_eeprom: eeprom@0 {
					reg = <0x0 0x1e00>;
				};

				macaddr_factory_4: macaddr@4 {
					compatible = "mac-base";
					reg = <0x4 0x6>;
					#nvmem-cell-cells = <1>;
				};
			};
		};

		partition@500000 {
			label = "tclinux";
			reg = <0x500000 0x2800000>;
			read-only;
		};

		partition@5500000 {
			label = "stock_data";
			reg = <0x5500000 0x800000>;
			read-only;
		};

		partition@6c80000 {
			label = "art";
			reg = <0x6c80000 0x380000>;
			read-only;
		};

		/* OpenWrt lives here: FIP + HDR2 (0x2100), then the FIT. */
		partition@2d00000 {
			compatible = "denx,fit";
			label = "tclinux_slave";
			reg = <0x2d00000 0x2800000>;
			openwrt,fit-offset = <0x2100>;
		};
	};
};

&switch {
	status = "okay";
};

&gsw_port1 {
	label = "lan1";
	status = "okay";
};

&gsw_port2 {
	label = "lan2";
	status = "okay";
};

&gsw_port3 {
	label = "lan3";
	status = "okay";
};

&gsw_port4 {
	label = "wan";
	nvmem-cells = <&macaddr_factory_4 (-1)>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};

/* Port LEDs are driven by the PHYs and are active-low on this board. */
&gsw_phy1 {
	leds {
		#address-cells = <1>;
		#size-cells = <0>;

		led@0 {
			reg = <0>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <0>;
			active-low;
		};

		led@1 {
			reg = <1>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <1>;
			active-low;
		};
	};
};

&gsw_phy2 {
	leds {
		#address-cells = <1>;
		#size-cells = <0>;

		led@0 {
			reg = <0>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <0>;
			active-low;
		};

		led@1 {
			reg = <1>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <1>;
			active-low;
		};
	};
};

&gsw_phy3 {
	leds {
		#address-cells = <1>;
		#size-cells = <0>;

		led@0 {
			reg = <0>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <0>;
			active-low;
		};

		led@1 {
			reg = <1>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <1>;
			active-low;
		};
	};
};

&gsw_phy4 {
	leds {
		#address-cells = <1>;
		#size-cells = <0>;

		led@0 {
			reg = <0>;
			function = LED_FUNCTION_WAN;
			function-enumerator = <0>;
			active-low;
		};

		led@1 {
			reg = <1>;
			function = LED_FUNCTION_WAN;
			function-enumerator = <1>;
			active-low;
		};
	};
};

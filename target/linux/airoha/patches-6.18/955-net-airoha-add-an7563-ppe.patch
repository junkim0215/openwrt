From: Iscle <albertiscle9@gmail.com>
Subject: [PATCH] net: airoha: add host-managed AN7563 PPE support

Use the AN7563 SRAM table geometry and initialize the packet classifier
from the host CPU. Keep NPU-dependent statistics disabled until the
AN7563 NPU interface is available.

Signed-off-by: Iscle <albertiscle9@gmail.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -1982,8 +1982,7 @@ static int airoha_hw_init(struct platfor
 		airoha_fe_wr(eth, REG_GDM_FWD_CFG(AIROHA_GDM1_IDX),
 			     GDM_PAD_EN_MASK);
 
-	if (eth->soc->version != 0x7563)
-		err = airoha_ppe_init(eth);
+	err = airoha_ppe_init(eth);
 
 	if (err)
 		goto error;
@@ -2295,8 +2294,6 @@ static int airoha_dev_open(struct net_de
 	 */
 	qdma = airoha_qdma_deref(dev);
 	qdma_id = qdma - &qdma->eth->qdma[0];
-	if (qdma->eth->soc->version == 0x7563)
-		pse_port = FE_PSE_PORT_CDM1;
 
 	if (qdma->users > 1 && (airoha_fe_lro_is_enabled(qdma->eth, qdma_id) ||
 				(netdev->features & NETIF_F_LRO))) {
@@ -3912,6 +3909,12 @@ static int airoha_tc_setup_qdisc_htb(str
 static int airoha_dev_tc_setup(struct net_device *dev,
 			       enum tc_setup_type type, void *type_data)
 {
+	struct airoha_gdm_dev *gdm = netdev_priv(dev);
+
+	if (airoha_is_7563(gdm->eth) &&
+	    (type == TC_SETUP_QDISC_ETS || type == TC_SETUP_QDISC_HTB))
+		return -EOPNOTSUPP;
+
 	switch (type) {
 	case TC_SETUP_QDISC_ETS:
 		return airoha_tc_setup_qdisc_ets(dev, type_data);
@@ -4174,8 +4177,9 @@ static int airoha_alloc_gdm_device(struc
 	netdev->features |= AIROHA_HW_FEATURES;
 	netdev->vlan_features = AIROHA_HW_FEATURES;
 	if (eth->soc->version == 0x7563) {
-		netdev->hw_features = 0;
+		netdev->hw_features = NETIF_F_HW_TC;
 		netdev->features &= ~(AIROHA_HW_FEATURES | NETIF_F_LRO);
+		netdev->features |= NETIF_F_HW_TC;
 		netdev->vlan_features = 0;
 	}
 	SET_NETDEV_DEV(netdev, eth->dev);
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -730,6 +730,11 @@ static inline bool airoha_is_7581(struct
 	return eth->soc->version == 0x7581;
 }
 
+static inline bool airoha_is_7563(struct airoha_eth *eth)
+{
+	return eth->soc->version == 0x7563;
+}
+
 static inline bool airoha_is_7583(struct airoha_eth *eth)
 {
 	return eth->soc->version == 0x7583;
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -41,7 +41,7 @@ static int airoha_ppe_get_num_stats_entr
 	if (!IS_ENABLED(CONFIG_NET_AIROHA_FLOW_STATS))
 		return -EOPNOTSUPP;
 
-	if (airoha_is_7583(ppe->eth))
+	if (airoha_is_7583(ppe->eth) || airoha_is_7563(ppe->eth))
 		return -EOPNOTSUPP;
 
 	return PPE_STATS_NUM_ENTRIES;
@@ -60,11 +60,16 @@ static int airoha_ppe_get_total_num_stat
 	return num_stats;
 }
 
+static u32 airoha_ppe_get_sram_num_entries(struct airoha_ppe *ppe)
+{
+	return airoha_is_7563(ppe->eth) ? 512 : PPE_SRAM_NUM_ENTRIES;
+}
+
 static u32 airoha_ppe_get_total_sram_num_entries(struct airoha_ppe *ppe)
 {
 	struct airoha_eth *eth = ppe->eth;
 
-	return PPE_SRAM_NUM_ENTRIES * eth->soc->num_ppe;
+	return airoha_ppe_get_sram_num_entries(ppe) * eth->soc->num_ppe;
 }
 
 u32 airoha_ppe_get_total_num_entries(struct airoha_ppe *ppe)
@@ -137,8 +142,8 @@ void airoha_ppe_set_xmit_frame_size(stru
 
 static void airoha_ppe_hw_init(struct airoha_ppe *ppe)
 {
-	u32 sram_ppe_num_data_entries = PPE_SRAM_NUM_ENTRIES, sram_num_entries;
-	u32 sram_tb_size, dram_num_entries;
+	u32 sram_ppe_num_data_entries = airoha_ppe_get_sram_num_entries(ppe);
+	u32 sram_num_entries, sram_tb_size, dram_num_entries;
 	struct airoha_eth *eth = ppe->eth;
 	int i, sram_num_stats_entries;
 
@@ -150,6 +155,7 @@ static void airoha_ppe_hw_init(struct ai
 	if (sram_num_stats_entries > 0)
 		sram_ppe_num_data_entries -= sram_num_stats_entries;
 	sram_ppe_num_data_entries =
+		sram_ppe_num_data_entries == 512 ? 7 :
 		PPE_RAM_NUM_ENTRIES_SHIFT(sram_ppe_num_data_entries);
 
 	for (i = 0; i < eth->soc->num_ppe; i++) {
@@ -396,6 +402,9 @@ static int airoha_ppe_foe_entry_prepare(
 			 * on port id otherwise.
 			 */
 			channel = dsa_port >= 0 ? dsa_port : port->id;
+			if (airoha_is_7563(eth) &&
+			    port->id == AIROHA_GDM2_IDX)
+				channel = 0;
 			channel = channel % AIROHA_NUM_QOS_CHANNELS;
 			priority = rt_tos2priority(dsfield);
 			priority = priority % AIROHA_NUM_QOS_QUEUES;
@@ -405,10 +414,14 @@ static int airoha_ppe_foe_entry_prepare(
 			val |= FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT, pse_port) |
 			       FIELD_PREP(AIROHA_FOE_IB2_DSCP, dsfield) |
 			       AIROHA_FOE_IB2_PSE_QOS;
+			/* Use direct MAC forwarding for active Ethernet. */
+			if (airoha_is_7563(eth) &&
+			    port->id == AIROHA_GDM2_IDX)
+				val &= ~AIROHA_FOE_IB2_PSE_QOS;
 			/* For downlink traffic consume SRAM memory for hw
 			 * forwarding descriptors queue.
 			 */
-			if (airoha_is_lan_gdm_dev(dev))
+			if (airoha_is_lan_gdm_dev(dev) && !airoha_is_7563(eth))
 				val |= AIROHA_FOE_IB2_FAST_PATH;
 			if (dsa_port >= 0)
 				val |= FIELD_PREP(AIROHA_FOE_IB2_NBQ,
@@ -695,7 +708,7 @@ airoha_ppe_foe_get_entry_locked(struct a
 
 	if (hash < sram_num_entries) {
 		u32 *hwe = ppe->foe + hash * sizeof(struct airoha_foe_entry);
-		bool ppe2 = hash >= PPE_SRAM_NUM_ENTRIES;
+		bool ppe2 = hash >= airoha_ppe_get_sram_num_entries(ppe);
 		struct airoha_eth *eth = ppe->eth;
 		u32 val;
 		int i;
@@ -750,7 +763,7 @@ static bool airoha_ppe_foe_compare_entry
 static int airoha_ppe_foe_commit_sram_entry(struct airoha_ppe *ppe, u32 hash)
 {
 	struct airoha_foe_entry *hwe = ppe->foe + hash * sizeof(*hwe);
-	bool ppe2 = hash >= PPE_SRAM_NUM_ENTRIES;
+	bool ppe2 = hash >= airoha_ppe_get_sram_num_entries(ppe);
 	u32 *ptr = (u32 *)hwe, val;
 	int i;
 
@@ -789,12 +802,12 @@ static int airoha_ppe_foe_commit_entry(s
 	rcu_read_lock();
 
 	npu = rcu_dereference(eth->npu);
-	if (!npu) {
+	if (!npu && !airoha_is_7563(eth)) {
 		err = -ENODEV;
 		goto unlock;
 	}
 
-	if (!rx_wlan)
+	if (!rx_wlan && npu)
 		airoha_ppe_foe_flow_stats_update(ppe, npu, hwe, hash);
 
 	if (hash < sram_num_entries)
@@ -1497,7 +1508,7 @@ int airoha_ppe_setup_tc_block_cb(struct
 
 	mutex_lock(&flow_offload_mutex);
 
-	if (!eth->npu)
+	if (!eth->npu && !airoha_is_7563(eth))
 		err = airoha_ppe_offload_setup(eth);
 	if (!err)
 		err = airoha_ppe_flow_offload_cmd(eth, type_data);
@@ -1601,6 +1612,35 @@ void airoha_ppe_put_dev(struct airoha_pp
 }
 EXPORT_SYMBOL_GPL(airoha_ppe_put_dev);
 
+static void airoha_ppe_an7563_init(struct airoha_ppe *ppe)
+{
+	struct airoha_eth *eth = ppe->eth;
+
+	/* Keep table accesses quiescent until the host-owned table is ready. */
+	airoha_fe_wr(eth, REG_PPE_PPE_FLOW_CFG(0), 0);
+	airoha_ppe_hw_init(ppe);
+	airoha_fe_clear(eth, REG_PPE_TB_CFG(0), PPE_TB_CFG_FIN_FAST_RP_MASK);
+	airoha_fe_set(eth, REG_PPE_TB_CFG(0),
+		      PPE_TB_CFG_AGE_TCP_FIN_MASK | PPE_TB_CFG_AGE_UDP_MASK |
+		      PPE_TB_CFG_AGE_TCP_MASK | PPE_TB_CFG_AGE_UNBIND_MASK |
+		      PPE_TB_CFG_AGE_NON_L4_MASK);
+	airoha_fe_wr(eth, REG_PPE_UNBIND_AGE(0),
+		     FIELD_PREP(PPE_UNBIND_AGE_MIN_PACKETS_MASK, 1000) |
+		     FIELD_PREP(PPE_UNBIND_AGE_DELTA_MASK, 3));
+	/* Allow the hardware to create new flows on a table miss. */
+	airoha_fe_wr(eth, REG_PPE_BIND_LIMIT0(0),
+		     FIELD_PREP(PPE_BIND_LIMIT0_QUARTER_MASK, 4000) |
+		     FIELD_PREP(PPE_BIND_LIMIT0_HALF_MASK, 4000));
+	airoha_fe_wr(eth, REG_PPE_BIND_LIMIT1(0),
+		     FIELD_PREP(PPE_BIND_LIMIT1_FULL_MASK, 8000) |
+		     FIELD_PREP(PPE_BIND_LIMIT1_NON_L4_MASK, 1));
+	/* AN7552 uses the same IPv4/IPv6 classifier enables as EN7581. */
+	airoha_fe_wr(eth, REG_PPE_PPE_FLOW_CFG(0),
+		     PPE_FLOW_CFG_IP4_NAPT_MASK | PPE_FLOW_CFG_IP4_NAT_MASK |
+		     PPE_FLOW_CFG_IP6_5T_ROUTE_MASK | PPE_FLOW_CFG_IP6_3T_ROUTE_MASK);
+	airoha_fe_set(eth, REG_PPE_GLO_CFG(0), PPE_GLO_CFG_EN_MASK);
+}
+
 int airoha_ppe_init(struct airoha_eth *eth)
 {
 	int foe_size, err, ppe_num_stats_entries;
@@ -1662,6 +1702,9 @@ int airoha_ppe_init(struct airoha_eth *e
 	if (err)
 		goto error_l2_flow_table_destroy;
 
+	if (airoha_is_7563(eth))
+		airoha_ppe_an7563_init(ppe);
+
 	return 0;
 
 error_l2_flow_table_destroy:
@@ -1681,6 +1724,11 @@ void airoha_ppe_deinit(struct airoha_eth
 
 	mutex_lock(&flow_offload_mutex);
 
+	if (airoha_is_7563(eth)) {
+		airoha_fe_clear(eth, REG_PPE_GLO_CFG(0), PPE_GLO_CFG_EN_MASK);
+		airoha_fe_wr(eth, REG_PPE_PPE_FLOW_CFG(0), 0);
+	}
+
 	npu = rcu_replace_pointer(eth->npu, NULL,
 				  lockdep_is_held(&flow_offload_mutex));
 	if (npu) {
--- a/drivers/net/ethernet/airoha/airoha_regs.h
+++ b/drivers/net/ethernet/airoha/airoha_regs.h
@@ -285,6 +285,7 @@
 #define PPE_IP_PROTO_CHK_IPV6_MASK		GENMASK(15, 0)
 
 #define REG_PPE_TB_CFG(_n)			(((_n) ? PPE2_BASE : PPE1_BASE) + 0x21c)
+#define PPE_TB_CFG_FIN_FAST_RP_MASK		BIT(27)
 #define PPE_SRAM_TB_NUM_ENTRY_MASK		GENMASK(26, 24)
 #define PPE_TB_CFG_KEEPALIVE_MASK		GENMASK(13, 12)
 #define PPE_TB_CFG_AGE_TCP_FIN_MASK		BIT(11)

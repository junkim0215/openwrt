+/* AN7563 frame engine stall monitor.
+ *
+ * Under CPU-forwarded load the AN7563 frame engine occasionally stops: the
+ * PSE input queues stay full, the QDMA keeps RX_DMA_BUSY set and never
+ * raises an interrupt again, and the only way back is a reset. The vendor
+ * driver (fe_core.ko, fe_monitor) polls the PSE input queue page counters
+ * every second and runs a PSE/QDMA recovery when their sum exceeds 0xa0.
+ * Do the same here, additionally requiring that the QDMA reports its RX
+ * DMA busy and that no QDMA interrupt arrived during the sample, so that a
+ * merely busy frame engine is left alone. The frame engine also dies in a
+ * second way: the PSE input queues stay empty, a few interrupts per second
+ * still arrive, but the PSE output queue towards PPE1 (every ingress frame
+ * goes through it) keeps the same non-zero page count for seconds, as the
+ * PPE no longer takes anything. Treat a frozen non-zero PPE1 output queue
+ * as a stall as well. Both need an open port, since frames park in the PSE
+ * before the ports come up.
+ */
+#define AIROHA_AN7563_PSE_IQ_STALL_PAGES	0xa0
+#define AIROHA_AN7563_PSE_OQ_STUCK_PAGES	8
+#define AIROHA_AN7563_STALL_SAMPLES		3
+
+/* When the QDMA RX DMA is wedged in a transaction the QDMA refuses to
+ * reset and any further register access may hang the bus; the only way
+ * out is a reboot, which at least brings the router back by itself.
+ */
+static bool airoha_an7563_reboot_on_wedge = true;
+module_param_named(reboot_on_wedge, airoha_an7563_reboot_on_wedge, bool, 0644);
+MODULE_PARM_DESC(reboot_on_wedge,
+		 "AN7563: reboot when the frame engine cannot be recovered (default: yes)");
+
+static u32 airoha_an7563_pse_iq_pages(struct airoha_eth *eth)
+{
+	u32 sta1 = airoha_fe_rr(eth, REG_PSE_IQ_STA1);
+	u32 sta2 = airoha_fe_rr(eth, REG_PSE_IQ_STA2);
+
+	return (sta1 & 0xff) + ((sta1 >> 8) & 0xff) + ((sta1 >> 16) & 0xff) +
+	       (sta1 >> 24) + (sta2 & 0xff) + ((sta2 >> 8) & 0xff) +
+	       ((sta2 >> 16) & 0xff);
+}
+
+static bool airoha_an7563_ports_open(struct airoha_eth *eth)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
+		if (eth->ports[i] && eth->ports[i]->users)
+			return true;
+	}
+
+	return false;
+}
+
+static void airoha_an7563_netdevs_tx(struct airoha_eth *eth, bool enable)
+{
+	int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
+		struct airoha_gdm_port *port = eth->ports[i];
+
+		if (!port)
+			continue;
+
+		for (j = 0; j < ARRAY_SIZE(port->devs); j++) {
+			struct net_device *netdev;
+
+			if (!port->devs[j])
+				continue;
+
+			netdev = netdev_from_priv(port->devs[j]);
+			if (!netif_running(netdev))
+				continue;
+
+			if (enable)
+				netif_tx_wake_all_queues(netdev);
+			else
+				netif_tx_disable(netdev);
+		}
+	}
+}
+
+/* Vendor-style datapath recovery: stop ingress and the CPU side, reset the
+ * frame engine core and the QDMA, program every ring again from the
+ * software state (no memory is reallocated) and restart.
+ */
+static void airoha_an7563_fe_recover(struct airoha_eth *eth, const char *why)
+{
+	struct airoha_qdma *qdma = &eth->qdma[0];
+	u32 fwd_cfg[AIROHA_GDM4_IDX + 1];
+	u32 status;
+	int i, err;
+
+	mutex_lock(&eth->stall_lock);
+	if (eth->stall_wedged) {
+		mutex_unlock(&eth->stall_lock);
+		return;
+	}
+
+	status = airoha_qdma_rr(qdma, REG_QDMA_GLOBAL_CFG);
+	dev_warn(eth->dev,
+		 "frame engine stall (%s): PSE IQ %08x %08x OQ %08x %08x QDMA %08x\n",
+		 why, airoha_fe_rr(eth, REG_PSE_IQ_STA1),
+		 airoha_fe_rr(eth, REG_PSE_IQ_STA2),
+		 airoha_fe_rr(eth, REG_PSE_OQ_STA1),
+		 airoha_fe_rr(eth, REG_PSE_OQ_STA2), status);
+
+	/* With the RX DMA wedged in a transaction the QDMA cannot be reset
+	 * and the recovery writes below hang the bus; do not touch it.
+	 */
+	if (status & GLOBAL_CFG_RX_DMA_BUSY_MASK) {
+		dev_err(eth->dev,
+			"the QDMA RX DMA is wedged, no recovery possible: %s\n",
+			airoha_an7563_reboot_on_wedge ? "rebooting" : "giving up");
+		eth->stall_wedged = true;
+		mutex_unlock(&eth->stall_lock);
+		if (airoha_an7563_reboot_on_wedge)
+			orderly_reboot();
+		return;
+	}
+	dev_info(eth->dev, "recovering the frame engine\n");
+
+	/* no new frames from the stack or the GDM ports */
+	airoha_an7563_netdevs_tx(eth, false);
+	for (i = AIROHA_GDM1_IDX; i <= AIROHA_GDM4_IDX; i++) {
+		fwd_cfg[i] = airoha_fe_rr(eth, REG_GDM_FWD_CFG(i));
+		airoha_set_gdm_port_fwd_cfg(eth, REG_GDM_FWD_CFG(i),
+					    FE_PSE_PORT_DROP);
+	}
+	msleep(100);
+
+	airoha_qdma_stop_napi(qdma);
+
+	/* stop the DMA; it stays busy on a stalled frame engine */
+	airoha_qdma_clear(qdma, REG_QDMA_GLOBAL_CFG,
+			  GLOBAL_CFG_TX_DMA_EN_MASK | GLOBAL_CFG_RX_DMA_EN_MASK);
+	read_poll_timeout(airoha_qdma_rr, status,
+			  !(status & (GLOBAL_CFG_TX_DMA_BUSY_MASK |
+				      GLOBAL_CFG_RX_DMA_BUSY_MASK)),
+			  USEC_PER_MSEC, 50 * USEC_PER_MSEC, true, qdma,
+			  REG_QDMA_GLOBAL_CFG);
+
+	/* frame engine core reset, then QDMA reset */
+	airoha_fe_set(eth, REG_FE_RST_GLO_CFG, FE_RST_CORE_MASK);
+	usleep_range(1000, 2000);
+
+	airoha_qdma_set(qdma, REG_QDMA_GLOBAL_CFG, GLOBAL_CFG_RESET_MASK);
+	if (read_poll_timeout(airoha_qdma_rr, status,
+			      status & GLOBAL_CFG_RESET_DONE_MASK,
+			      USEC_PER_MSEC, 50 * USEC_PER_MSEC, true, qdma,
+			      REG_QDMA_GLOBAL_CFG)) {
+		airoha_qdma_clear(qdma, REG_QDMA_GLOBAL_CFG,
+				  GLOBAL_CFG_RESET_MASK);
+		dev_err(eth->dev,
+			"QDMA reset not confirmed (%08x): the RX DMA is wedged, %s\n",
+			status, airoha_an7563_reboot_on_wedge ? "rebooting" :
+			"giving up");
+		eth->stall_wedged = true;
+		mutex_unlock(&eth->stall_lock);
+		if (airoha_an7563_reboot_on_wedge)
+			orderly_reboot();
+		return;
+	}
+	airoha_qdma_clear(qdma, REG_QDMA_GLOBAL_CFG, GLOBAL_CFG_RESET_MASK);
+	usleep_range(1000, 2000);
+
+	/* release everything in flight and program the rings again */
+	airoha_qdma_tx_cleanup(qdma);
+	for (i = 0; i < ARRAY_SIZE(qdma->q_tx); i++) {
+		struct airoha_queue *q = &qdma->q_tx[i];
+		u16 index = 0;
+
+		if (!q->ndesc)
+			continue;
+
+		spin_lock_bh(&q->lock);
+		if (!list_empty(&q->tx_list))
+			index = list_first_entry(&q->tx_list,
+						 struct airoha_queue_entry,
+						 list) - q->entry;
+		q->head = index;
+		q->flushing = false;
+		q->txq_stopped = false;
+		airoha_qdma_tx_queue_hw_init(q, index);
+		spin_unlock_bh(&q->lock);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(qdma->q_tx_irq); i++) {
+		if (qdma->q_tx_irq[i].size)
+			airoha_qdma_tx_irq_hw_init(&qdma->q_tx_irq[i]);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(qdma->q_rx); i++) {
+		struct airoha_queue *q = &qdma->q_rx[i];
+
+		if (!q->ndesc)
+			continue;
+
+		airoha_qdma_cleanup_rx_queue(q);
+		airoha_qdma_rx_queue_hw_init(q);
+		airoha_qdma_fill_rx_queue(q);
+	}
+
+	err = airoha_qdma_an7563_hfwd_hw_init(qdma);
+	if (err)
+		dev_warn(eth->dev, "hw forwarding queue init failed: %d\n", err);
+	airoha_qdma_hw_init(qdma);
+
+	/* restart */
+	airoha_qdma_start_napi(qdma);
+	airoha_qdma_set(qdma, REG_QDMA_GLOBAL_CFG,
+			GLOBAL_CFG_TX_DMA_EN_MASK | GLOBAL_CFG_RX_DMA_EN_MASK);
+	for (i = AIROHA_GDM1_IDX; i <= AIROHA_GDM4_IDX; i++)
+		airoha_fe_wr(eth, REG_GDM_FWD_CFG(i), fwd_cfg[i]);
+	airoha_an7563_netdevs_tx(eth, true);
+
+	eth->recoveries++;
+	eth->irq_events_seen = eth->irq_events;
+	eth->ppe_oq_pages_seen = 0;
+	eth->stall_samples = 0;
+	dev_info(eth->dev, "frame engine recovered (%u so far): PSE IQ %08x %08x QDMA %08x\n",
+		 eth->recoveries, airoha_fe_rr(eth, REG_PSE_IQ_STA1),
+		 airoha_fe_rr(eth, REG_PSE_IQ_STA2),
+		 airoha_qdma_rr(qdma, REG_QDMA_GLOBAL_CFG));
+
+	mutex_unlock(&eth->stall_lock);
+}
+
+/* The TX done queue occasionally reports a descriptor before its DONE bit
+ * is visible; airoha_qdma_tx_napi_poll() then consumes the report without
+ * releasing the descriptor, and every such loss leaves q->queued one higher.
+ * After a few thousand losses the driver sees the ring as full, stops the
+ * netdev queues for good and transmits nothing while the hardware ring is
+ * idle. Release such descriptors here: every in-flight entry whose DONE bit
+ * is set, or all of them when the hardware has consumed the whole ring
+ * (CPU index == DMA index).
+ */
+static void airoha_an7563_tx_reclaim(struct airoha_eth *eth)
+{
+	struct airoha_qdma *qdma = &eth->qdma[0];
+	struct airoha_queue *q = &qdma->q_tx[0];
+	u32 cpu, dma, n = 0;
+	bool idle, settled;
+	int i;
+
+	if (!q->ndesc)
+		return;
+
+	spin_lock_bh(&q->lock);
+
+	cpu = FIELD_GET(TX_RING_CPU_IDX_MASK,
+			airoha_qdma_rr(qdma, REG_TX_CPU_IDX(0)));
+	dma = FIELD_GET(TX_RING_DMA_IDX_MASK,
+			airoha_qdma_rr(qdma, REG_TX_DMA_IDX(0)));
+	idle = cpu == dma;
+
+	/* airoha_qdma_tx_napi_poll() normally releases every entry; only
+	 * entries still in flight a whole tick after the hardware went idle,
+	 * with nothing queued in between, are lost
+	 */
+	settled = idle && q->queued && cpu == eth->tx_reclaim_cpu &&
+		  q->queued == eth->tx_reclaim_queued;
+	eth->tx_reclaim_cpu = cpu;
+	eth->tx_reclaim_queued = q->queued;
+
+	for (i = 0; settled && i < q->ndesc && q->queued; i++) {
+		struct airoha_queue_entry *e = &q->entry[i];
+		struct airoha_qdma_desc *desc = &q->desc[i];
+		struct sk_buff *skb = e->skb;
+
+		if (e->dma_type == AIROHA_DMA_UNMAPPED)
+			continue;
+
+		/* a stale done-queue report for this entry is skipped by
+		 * airoha_qdma_tx_napi_poll() as the DONE bit is gone
+		 */
+		WRITE_ONCE(desc->ctrl, 0);
+		e->skb = NULL;
+		airoha_unmap_xmit_buf(eth, e);
+		list_add_tail(&e->list, &q->tx_list);
+		WRITE_ONCE(desc->msg0, 0);
+		WRITE_ONCE(desc->msg1, 0);
+		q->queued--;
+		n++;
+
+		if (skb) {
+			struct airoha_gdm_dev *dev = netdev_priv(skb->dev);
+			u16 qidx = skb_get_queue_mapping(skb);
+			struct netdev_queue *txq;
+
+			txq = skb_get_tx_queue(skb->dev, skb);
+			spin_lock_bh(&dev->txq_lock[qidx]);
+			netdev_tx_completed_queue(txq, 1, skb->len);
+			spin_unlock_bh(&dev->txq_lock[qidx]);
+			dev_kfree_skb_any(skb);
+		}
+	}
+
+	eth->tx_queued = q->queued;
+	if (n) {
+		eth->tx_reclaimed += n;
+		if (q->txq_stopped && q->ndesc - q->queued >= q->free_thr)
+			airoha_qdma_wake_netdev_txqs(q);
+	}
+
+	spin_unlock_bh(&q->lock);
+
+	if (n)
+		dev_info_ratelimited(eth->dev,
+				     "reclaimed %u TX descriptors (%u so far, ring %s, %u queued)\n",
+				     n, eth->tx_reclaimed, idle ? "idle" : "busy",
+				     eth->tx_queued);
+}
+
+/* count and clear the PSE events the stock driver reports */
+static void airoha_an7563_pse_events(struct airoha_eth *eth)
+{
+	u32 st = airoha_fe_rr(eth, REG_FE_INT_STATUS);
+	u32 ev = st & (FE_INT_PSE_FC_MASK | FE_INT_PSE_FQ_EMPTY |
+		       FE_INT_PSE_FC_DROP | FE_INT_PSE_EXCEPTION);
+
+	if (!ev)
+		return;
+
+	airoha_fe_wr(eth, REG_FE_INT_STATUS, ev);
+	if (ev & FE_INT_PSE_FQ_EMPTY)
+		eth->pse_fq_empty++;
+	if (ev & FE_INT_PSE_FC_DROP)
+		eth->pse_fc_drop++;
+	if (ev & FE_INT_PSE_FC_MASK)
+		eth->pse_fc++;
+	if (ev & FE_INT_PSE_EXCEPTION)
+		eth->pse_exception++;
+	dev_info_ratelimited(eth->dev,
+			     "PSE events %08x (fq empty %u, fc drop %u, fc %u, exception %u)\n",
+			     st, eth->pse_fq_empty, eth->pse_fc_drop,
+			     eth->pse_fc, eth->pse_exception);
+}
+
+static void airoha_an7563_stall_work(struct work_struct *work)
+{
+	struct airoha_eth *eth = container_of(work, struct airoha_eth,
+					      stall_work.work);
+	u32 irq_events = READ_ONCE(eth->irq_events);
+	bool idle = irq_events == eth->irq_events_seen;
+	u32 pages, busy, ppe_oq;
+	bool iq_full, oq_stuck;
+
+	eth->irq_events_seen = irq_events;
+	if (!test_bit(DEV_STATE_INITIALIZED, &eth->state))
+		goto out;
+
+	pages = airoha_an7563_pse_iq_pages(eth);
+	busy = airoha_qdma_rr(&eth->qdma[0], REG_QDMA_GLOBAL_CFG) &
+	       GLOBAL_CFG_RX_DMA_BUSY_MASK;
+	iq_full = pages > AIROHA_AN7563_PSE_IQ_STALL_PAGES && idle && busy;
+
+	ppe_oq = airoha_fe_rr(eth, REG_PSE_OQ_STA2) & 0xff;
+	oq_stuck = ppe_oq > AIROHA_AN7563_PSE_OQ_STUCK_PAGES &&
+		   ppe_oq == eth->ppe_oq_pages_seen;
+	eth->ppe_oq_pages_seen = ppe_oq;
+
+	if ((iq_full || oq_stuck) && airoha_an7563_ports_open(eth))
+		eth->stall_samples++;
+	else
+		eth->stall_samples = 0;
+
+	airoha_an7563_pse_events(eth);
+	airoha_an7563_tx_reclaim(eth);
+
+	if (eth->stall_samples >= AIROHA_AN7563_STALL_SAMPLES)
+		airoha_an7563_fe_recover(eth, "monitor");
+out:
+	if (!eth->stall_wedged)
+		schedule_delayed_work(&eth->stall_work, HZ);
+}

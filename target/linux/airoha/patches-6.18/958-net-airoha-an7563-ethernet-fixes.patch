 	/* PSE IQ reserve */
 	airoha_fe_rmw(eth, REG_PSE_IQ_REV1, PSE_IQ_RES1_P2_MASK,
@@ -1047,6 +1150,36 @@
 	return done;
 }
 
+/* Program the QDMA RX ring registers from the software state; also run
+ * after a QDMA reset.
+ */
+static void airoha_qdma_rx_queue_hw_init(struct airoha_queue *q)
+{
+	struct airoha_qdma *qdma = q->qdma;
+	int qid = q - &qdma->q_rx[0], thr;
+
+	airoha_qdma_wr(qdma, REG_RX_RING_BASE(qid), q->desc_dma);
+	airoha_qdma_rmw(qdma, REG_RX_RING_SIZE(qid),
+			RX_RING_SIZE_MASK,
+			FIELD_PREP(RX_RING_SIZE_MASK, q->ndesc));
+
+	thr = clamp(q->ndesc >> 3, 1, 32);
+	airoha_qdma_rmw(qdma, REG_RX_RING_SIZE(qid), RX_RING_THR_MASK,
+			FIELD_PREP(RX_RING_THR_MASK, thr));
+	airoha_qdma_rmw(qdma, REG_RX_DMA_IDX(qid), RX_RING_DMA_IDX_MASK,
+			FIELD_PREP(RX_RING_DMA_IDX_MASK, q->head));
+	/* With scatter-gather the AN7563 QDMA splits frames at 1 KiB and
+	 * shifts the first buffer by two bytes; its buffers fit a full
+	 * frame anyway.
+	 */
+	if (airoha_qdma_is_lro_queue(q) || qdma->eth->soc->version == 0x7563)
+		airoha_qdma_clear(qdma, REG_RX_SCATTER_CFG(qid),
+				  RX_RING_SG_EN_MASK);
+	else
+		airoha_qdma_set(qdma, REG_RX_SCATTER_CFG(qid),
+				RX_RING_SG_EN_MASK);
+}

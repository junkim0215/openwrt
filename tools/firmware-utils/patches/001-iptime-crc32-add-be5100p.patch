From ce130b5ccb22cc4114cb0f57aa55647561d7e645 Mon Sep 17 00:00:00 2001
From: Jun-Hyuk Kim <junhyukkim38@gmail.com>
Date: Sat, 14 Nov 2026 20:00:00 +0900
Subject: [PATCH] iptime-crc32: add be5100p

Add support for the ipTIME BE5100plus. Its firmware header uses the
same layout and checksum as the other models, with the payload at 0x38.
The U-Boot recovery mode of the device accepts images made with it.

The stock firmware puts its own version at 0x24 instead of 0x8, but
neither the recovery mode nor the stock firmware requires it.

Signed-off-by: Jun-Hyuk Kim <junhyukkim38@gmail.com>
---
 src/iptime-crc32.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/iptime-crc32.c b/src/iptime-crc32.c
index 35bc0b0..8a664b5 100644
--- a/src/iptime-crc32.c
+++ b/src/iptime-crc32.c
@@ -62,6 +62,7 @@ struct board_info boards[] = {
 	{ .model = "ax8004m", .payload_offset = 0x38 },
 	{ .model = "ax3kse", .payload_offset = 0x38 },
 	{ .model = "ax3ksm", .payload_offset = 0x38 },
+	{ .model = "be5100p", .payload_offset = 0x38 },
 	{ /* sentinel */ }
 };
 
